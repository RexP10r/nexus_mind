GRPC_ADDR=http://[::1]:50051
HTTP_PORT=8080
LOG_LEVEL=info
LOG_JSON=false
MAX_ITERATIONS=10
REQUEST_TIMEOUT=60
PROVIDER_TYPE=grpc
AGENT_TYPE=rag
REDIS_URL=redis://localhost:6379
MONGO_URI=mongodb://localhost:27017
MONGO_DB=nexus_mind
HISTORY_MAX_MESSAGES=10
SUMMARY_INTERVAL=5
REDIS_TTL_SECS=86400
QDRANT_URL=http://localhost:6334
QDRANT_COLLECTION=nexus_docs
ENABLE_BERT=false
ONNX_MODEL_PATH=models/model.onnx
ONNX_TOKENIZER_PATH=models/tokenizer.json
